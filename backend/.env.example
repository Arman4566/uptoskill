# Copy this file to .env and fill in the values. NEVER share or commit .env (it holds secrets).

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME      # your PostgreSQL / Neon connection string
JWT_SECRET=PUT_A_LONG_RANDOM_STRING_HERE                       # e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PORT=4000
NODE_ENV=development
# Comma-separated list of frontends allowed to call the API (needed when NODE_ENV=production).
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500

STARTER_CREDITS=10

# --- Virtual classroom (LiveKit Cloud) ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# --- AI quizzes, weak-topic analysis and tutor reports (Grok by xAI) ---
# Get a key at https://console.x.ai  (API Keys). The key stays on the server.
XAI_API_KEY=PUT_YOUR_XAI_KEY_HERE
# Model name exactly as your xAI console lists it. If you get "model not found", change this.
GROK_MODEL=grok-4
# XAI_BASE_URL=https://api.x.ai/v1

# Quiz rules (optional, these are the defaults)
# QUIZ_QUESTIONS=5          questions per quiz
# QUIZ_PASS_PCT=60          below this: no credits, AI explains weak topics, tutor gets a report
# QUIZ_PERFECT_PCT=80       at or above this: the bigger reward
# QUIZ_REWARD_PASS=1        credits for passing
# QUIZ_REWARD_PERFECT=2     credits for a great score
# QUIZ_DAILY_LIMIT=10       quizzes one student can start per day (each uses one AI call)
# QUIZ_VIDEO_MAX_MB=60      largest tutor video

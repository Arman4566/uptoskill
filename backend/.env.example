DATABASE_URL=postgres://postgres:postgres@localhost:5432/uptoskill
JWT_SECRET=change-me
PORT=4000
# Comma-separated list of frontends allowed to call the API.
# 5173 = Vite, 5500/5501 = VS Code Live Server, "null" = opening index.html by double-click (file://).
CLIENT_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,null
# Free credits for new accounts. They can be spent on lessons but are never withdrawable. 0 = none.
STARTER_CREDITS=0
REQUEST_TTL_MIN=30
ACCEPTED_TTL_MIN=60
BONUS_DAILY_CAP=3

# ---------------- Money (simulated) and video (see README "Payments and video") ----------------
# 1 credit = this many paise (100 = Rs 1). Used for buying and for withdrawing.
CREDIT_PRICE_PAISE=100
# Website fee as a % of what the student pays. Tutor sets 95 -> student sees 100.
PLATFORM_FEE_PCT=5
MIN_PURCHASE_CREDITS=50
MAX_PURCHASE_CREDITS=50000
MIN_WITHDRAW_CREDITS=100
MAX_WITHDRAW_CREDITS=50000

# SimPay: the built-in simulated payment gateway + pretend bank. No real money, no keys to get.
# Signs the proof that a payment happened. Any long random string; change it for anything public.
SIMPAY_SECRET=change-me-too
# How long the pretend bank takes to finish a withdrawal (ms), and when the gateway's own "captured" call-back lands.
SIMPAY_PAYOUT_DELAY_MS=8000
SIMPAY_WEBHOOK_DELAY_MS=2500
# Every user's pretend bank account starts with this many rupees.
SIMPAY_OPENING_BALANCE_RUPEES=10000

# Daily.co (video, screen share, cloud recording). DAILY_DOMAIN is the part before .daily.co
DAILY_API_KEY=
DAILY_DOMAIN=
# Base64 string you choose; register the SAME value with Daily (npm run daily:webhook).
DAILY_WEBHOOK_SECRET=
DAILY_AUTO_RECORD=true

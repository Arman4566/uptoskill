# Copy to .env and fill in. NEVER commit .env or put real secrets in this example file.
# Postgres connection string (local example, or your Neon / Supabase URL).
DATABASE_URL=postgresql://neondb_owner:npg_JfIUiK72zWbm@ep-gentle-hat-b4rkjloq-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Extra frontends allowed to call the API (comma-separated). In development every localhost / 127.0.0.1 port
# (8000, 5500, 5173, ...) and file:// pages are already allowed, so this is only needed for a deployed site.
CLIENT_ORIGIN=
# Set to production on a real server: then ONLY the origins in CLIENT_ORIGIN are allowed.
NODE_ENV=development
STARTER_CREDITS=10
REQUEST_TTL_MIN=30
ACCEPTED_TTL_MIN=60
BONUS_DAILY_CAP=3

# Virtual classroom (LiveKit Cloud). Server side only - never put these in frontend files.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

DATABASE_URL=postgres://postgres:postgres@localhost:5432/uptoskill
JWT_SECRET=change-me
PORT=4000
# Comma-separated list of frontends allowed to call the API.
# 5173 = Vite, 5500/5501 = VS Code Live Server, "null" = opening index.html by double-click (file://).
CLIENT_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,null
STARTER_CREDITS=10
REQUEST_TTL_MIN=30
ACCEPTED_TTL_MIN=60
BONUS_DAILY_CAP=3
